# AICTE Complaint Monitoring Dashboard - Server Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# MongoDB Connection
# For local MongoDB: mongodb://127.0.0.1:27017/aicte_complaints
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/aicte_complaints?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aicte_complaints

# JWT Configuration
JWT_SECRET=aicte_super_secret_jwt_key_sentinel2026_dev_only_change_in_prod
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Client URL)
CLIENT_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Deadline Configuration (Days)
DEADLINE_APPROACHING_DAYS=3
